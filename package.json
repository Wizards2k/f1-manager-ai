{
  "name": "f1-manager-ai",
  "version": "1.0.0",
  "description": "F1 Manager AI - Desktop Edition",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-electron.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.wizards2k.f1-manager-ai",
    "productName": "F1 Manager AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "python_backend/**/*",
      "!python_backend/**/*.pyc",
      "!python_backend/**/__pycache__",
      "!python_backend/.gitignore",
      "!python_backend/server.log"
    ],
    "extraResources": [
      {
        "from": "python_backend",
        "to": "python_backend",
        "filter": [
          "**/*",
          "!**/*.pyc",
          "!**/__pycache__",
          "!.gitignore",
          "!server.log"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  }
}
